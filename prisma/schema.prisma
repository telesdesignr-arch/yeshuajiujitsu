// Banco de dados do Yeshua Jiu-Jitsu
//
// IMPORTANTE: este schema foi escrito para ser portavel.
// Em desenvolvimento usamos SQLite (arquivo local, zero configuracao).
// Para publicar na Vercel, basta trocar `provider = "sqlite"` por
// `provider = "postgresql"` abaixo. Nada mais precisa mudar --
// por isso nao usamos enums nativos nem tipos especificos de banco.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Pessoas
// ---------------------------------------------------------------------------

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  passwordHash       String
  name               String
  role               String   @default("ALUNO") // ALUNO | PROFESSOR | ADMIN
  active             Boolean  @default(true)
  mustChangePassword Boolean  @default(true)

  // Quando o aluno pediu ajuda para entrar. O professor ve o pedido no painel
  // e gera uma senha temporaria. Vazio = nao ha pedido pendente.
  //
  // Guardamos so a data, e nao um token de redefinicao: enquanto nao existe
  // servico de envio de e-mail, quem entrega a senha nova e o professor, pelo
  // WhatsApp. Quando o e-mail entrar, este campo vira o gatilho do envio.
  passwordResetRequestedAt DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  student            Student?            @relation("StudentProfile")
  studentsResponsible Student[]          @relation("ResponsibleProfessor")
  graduationsAwarded Graduation[]        @relation("AwardedBy")
  sessionsTaught     AttendanceSession[] @relation("SessionProfessor")
  schedulesTaught    ClassSchedule[]     @relation("ScheduleProfessor")
  notesAuthored      StudentNote[]       @relation("NoteAuthor")
  paymentsConfirmed  Invoice[]           @relation("PagamentoConfirmado")

  @@index([role])
}

model Student {
  id           String    @id @default(cuid())
  userId       String    @unique
  user         User      @relation("StudentProfile", fields: [userId], references: [id], onDelete: Cascade)

  photoUrl     String?
  phone        String?
  birthDate    DateTime?
  joinedAt     DateTime  @default(now()) // data de entrada na academia

  professorId  String?
  professor    User?     @relation("ResponsibleProfessor", fields: [professorId], references: [id], onDelete: SetNull)

  // graduacao atual
  belt         String    @default("BRANCA") // BRANCA | AZUL | ROXA | MARROM | PRETA
  degree       Int       @default(0) // 0 a 4 graus
  beltSinceAt  DateTime  @default(now()) // desde quando esta nesta faixa/grau

  // metas e status
  monthlyGoal  Int       @default(12) // meta de treinos por mes
  active       Boolean   @default(true)
  isCompetitor Boolean   @default(false)

  guardianName     String? // responsavel, para alunos menores de idade
  emergencyContact String?
  observations     String?

  // Financeiro
  planId         String?
  plan           Plan?   @relation(fields: [planId], references: [id], onDelete: SetNull)
  // Dia do vencimento (1 a 28). 28 e o limite para existir em fevereiro.
  dueDay         Int     @default(10)
  // Valor proprio, quando o aluno tem desconto ou bolsa. Vazio = usa o plano.
  customFeeCents Int?
  financialNotes String?

  graduations  Graduation[]
  attendances  Attendance[]
  journal      StudentNote[]
  results      CompetitionResult[]
  invoices     Invoice[]

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([belt])
  @@index([active])
}

// ---------------------------------------------------------------------------
// Graduacoes
// ---------------------------------------------------------------------------

model Graduation {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  belt        String
  degree      Int
  date        DateTime

  awardedById String?
  awardedBy   User?    @relation("AwardedBy", fields: [awardedById], references: [id], onDelete: SetNull)

  photoUrl    String?
  notes       String?
  criteria    String? // JSON: [{ "nome": "Defesa pessoal", "nota": 4 }]

  createdAt   DateTime @default(now())

  @@index([studentId, date])
}

// ---------------------------------------------------------------------------
// Aulas, agenda e presenca
// ---------------------------------------------------------------------------

// Horario fixo e recorrente da semana. Ex.: Segunda, 19:00, Jiu-Jitsu Gi.
model ClassSchedule {
  id          String  @id @default(cuid())
  weekday     Int // 0 = domingo ... 6 = sabado
  startTime   String // "19:00"
  endTime     String // "20:30"
  title       String
  type        String  @default("GI") // GI | NOGI | KIDS | OPEN_MAT | FEMININO | BOXE
  professorId String?
  professor   User?   @relation("ScheduleProfessor", fields: [professorId], references: [id], onDelete: SetNull)
  active      Boolean @default(true)
  sortOrder   Int     @default(0)

  sessions    AttendanceSession[]

  @@index([weekday, active])
}

// Uma aula que realmente aconteceu, com a chamada feita pelo professor.
model AttendanceSession {
  id          String   @id @default(cuid())
  date        DateTime
  title       String
  type        String   @default("GI")

  scheduleId  String?
  schedule    ClassSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  professorId String?
  professor   User?    @relation("SessionProfessor", fields: [professorId], references: [id], onDelete: SetNull)

  techniques  String? // tecnicas ensinadas na aula
  notes       String?

  attendances Attendance[]

  createdAt   DateTime @default(now())

  @@index([date])
}

model Attendance {
  id        String            @id @default(cuid())
  sessionId String
  session   AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId String
  student   Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  present   Boolean           @default(true)

  // Copia da data da aula (AttendanceSession.date).
  //
  // Sim, e informacao repetida -- de proposito. Sem ela, toda contagem de
  // frequencia vira um JOIN com a tabela de aulas, e descobrir "qual foi o
  // ultimo treino de cada aluno" obriga a carregar todas as presencas da
  // academia na memoria. Com esta coluna, essas perguntas viram um indice.
  // Quem escreve as duas datas juntas e a acao de salvar a chamada.
  date      DateTime

  createdAt DateTime          @default(now())

  @@unique([sessionId, studentId])
  @@index([studentId, date])
  @@index([date])
}

// Eventos avulsos da agenda: campeonato, graduacao, seminario, confraternizacao.
model Event {
  id          String    @id @default(cuid())
  title       String
  type        String    @default("OUTRO") // CAMPEONATO | GRADUACAO | SEMINARIO | TREINO_ESPECIAL | CONFRATERNIZACAO | OUTRO
  startsAt    DateTime
  endsAt      DateTime?
  location    String?
  description String?
  imageUrl    String?
  link        String?
  createdAt   DateTime  @default(now())

  @@index([startsAt])
}

// ---------------------------------------------------------------------------
// Financeiro
// ---------------------------------------------------------------------------
//
// TODO VALOR EM DINHEIRO E GUARDADO EM CENTAVOS, como numero inteiro.
// Guardar 149.90 como decimal parece mais natural, mas numero quebrado no
// computador acumula erro de arredondamento -- e em dinheiro isso vira
// diferenca de centavos no fechamento do mes. R$ 149,90 aqui e 14990.

// Plano de mensalidade da academia. Ex.: "Adulto 3x por semana".
model Plan {
  id          String   @id @default(cuid())
  name        String
  priceCents  Int
  description String?
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  students Student[]

  @@index([active])
}

// Uma mensalidade de um aluno num mes.
model Invoice {
  id        String  @id @default(cuid())
  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // Mes de competencia, no formato "2026-08". Texto e nao data de proposito:
  // "a mensalidade de agosto" e um mes do calendario, nao um instante, entao
  // nao pode escorregar por fuso horario.
  referenceMonth String
  dueDate        DateTime

  // Valor copiado do plano no momento em que a mensalidade foi gerada.
  // Se o plano mudar de preco depois, as mensalidades antigas nao mudam.
  amountCents   Int
  discountCents Int @default(0)

  // PENDENTE | EM_ANALISE | PAGO | CANCELADO
  // "ATRASADO" nao e guardado: e calculado (pendente + venceu). Assim nao
  // depende de nenhuma rotina rodar na hora certa para ficar correto.
  status String @default("PENDENTE")

  paidAt        DateTime?
  paymentMethod String? // PIX | DINHEIRO | CARTAO | TRANSFERENCIA | OUTRO
  notes         String?

  // Quem confirmou o pagamento no sistema
  confirmedById String?
  confirmedBy   User?   @relation("PagamentoConfirmado", fields: [confirmedById], references: [id], onDelete: SetNull)

  // Reservado para o intermediador de pagamento (Mercado Pago). Ainda nao
  // usado: fica aqui para a integracao entrar sem migracao de banco depois.
  externalId       String?
  externalStatus   String?
  paymentUrl       String?
  qrCode           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Um aluno tem no maximo uma mensalidade por mes. Isso e o que impede a
  // geracao em lote de duplicar cobranca se for rodada duas vezes.
  @@unique([studentId, referenceMonth])
  @@index([status, dueDate])
  @@index([referenceMonth])
}

// Configuracoes da academia. Tabela de uma linha so.
model AcademySettings {
  id            String   @id @default("unica")
  pixKey        String?
  pixOwnerName  String?
  defaultDueDay Int      @default(10)
  updatedAt     DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Campeonatos
// ---------------------------------------------------------------------------

// Um campeonato e uma entidade propria, e nao apenas um item da agenda: tem
// prazo de inscricao, modalidade, link de inscricao e -- principalmente --
// os resultados de cada atleta da equipe.
model Competition {
  id                   String    @id @default(cuid())
  name                 String
  date                 DateTime
  endDate              DateTime?
  location             String?
  organizer            String? // IBJJF, CBJJ, federacao estadual...
  modality             String    @default("GI") // GI | NOGI | AMBOS
  registrationUrl      String?
  registrationDeadline DateTime?
  description          String?
  // Cartaz do campeonato. Guardamos o endereco da imagem no site da
  // federacao, e nao uma copia: e o proprio organizador que mantem.
  imageUrl             String?
  createdAt            DateTime  @default(now())

  results CompetitionResult[]

  @@index([date])
}

model CompetitionResult {
  id            String      @id @default(cuid())
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  studentId     String
  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)

  // 1, 2, 3 = podio. 0 = participou sem medalha. 4+ = colocacao informada.
  placement Int     @default(0)
  // Categoria em que lutou: "Azul · Medio", "Absoluto", "Infantil A"...
  // Um mesmo atleta pode ter mais de um resultado no mesmo campeonato
  // (peso e absoluto), por isso nao ha restricao de unicidade aqui.
  category  String?
  modality  String  @default("GI") // GI | NOGI
  notes     String?

  createdAt DateTime @default(now())

  @@index([studentId])
  @@index([competitionId])
}

// ---------------------------------------------------------------------------
// Diario do aluno (observacoes do professor)
// ---------------------------------------------------------------------------

model StudentNote {
  id               String   @id @default(cuid())
  studentId        String
  student          Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  authorId         String?
  author           User?    @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  content          String
  date             DateTime @default(now())
  visibleToStudent Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([studentId, date])
}
