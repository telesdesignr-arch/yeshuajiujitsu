# Copie este arquivo para ".env" e preencha os valores.

# No seu computador (banco em arquivo):
DATABASE_URL="file:./dev.db"

# Na internet (Neon / Vercel), fica assim:
# DATABASE_URL="postgresql://usuario:senha@host.neon.tech/banco?sslmode=require"

# Frase secreta que protege o login dos alunos.
# Invente uma frase longa, sem espacos, com pelo menos 40 caracteres.
AUTH_SECRET="troque-esta-frase-por-uma-sua-bem-comprida-e-secreta"
